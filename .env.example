# =========================================================================
# Site de base — configuration. Copier en .env et remplir.
#   cp .env.example .env
# =========================================================================

# --- Flask ---
# Clé secrète des sessions. Génère-la : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Mets à true dès que tu es derrière HTTPS (Cloudflare) :
SESSION_COOKIE_SECURE=false

# --- Identité / marque (personnalise pour ton projet) ---
BRAND_PREFIX=V
BRAND_SUFFIX=TC
BRAND_BADGE=taxi · vtc

# --- Base de données ---
# Conserve ce chemin identique à ta base existante pour préserver les données
# (comptes + courses/clients/tarifs/lieux). En reprise d'une base « v1 »,
# lance d'abord la migration : python manage.py migrate_app  (voir README).
DATABASE_PATH=./data/vtc.db

# --- Super-admin (amorce au premier lancement) ---
# (À l'install express, on peut passer ADMIN_EMAIL / ADMIN_PASSWORD à la commande :
#  ils remplissent ces deux champs. Voir docs/deploiement-proxmox.md §2.)
# Mot de passe pour l'accès local (LAN) par mot de passe.
SUPERADMIN_PASSWORD=
# Ton e-mail Google, celui que tu autoriseras dans Cloudflare Access.
SUPERADMIN_EMAIL=

# --- Cloudflare Zero Trust (Access) ---
# Ces 3 valeurs peuvent aussi se régler dans l'UI (Paramètres → Cloudflare / Accès),
# qui PRIME sur ce fichier. Ici = valeurs de secours au premier démarrage.
# https://<team>.cloudflareaccess.com  →  ici on met juste <team>
CF_ACCESS_TEAM_DOMAIN=
# AUD tag de l'application Access (Zero Trust → Access → ton app → Overview).
CF_ACCESS_AUD=
# Vérifier le JWT Cloudflare (recommandé : true en prod).
CF_VERIFY_JWT=true
# Autoriser le login local par mot de passe (accès LAN sans Cloudflare).
ALLOW_LOCAL_LOGIN=true

# --- Permissions (à demander à la création du site — voir docs/permissions.md) ---
# Niveau par fonctionnalité : off | membre | super_admin.
# Astuce : `python -m panel.setup` pose ces questions et remplit ce fichier
#          (ou `--preset hub` / `--preset perso`).
#
# Gestion des comptes (demandes, valider, refuser, bloquer, supprimer, rôles).
#   off  → site « perso » : utilisateurs auto-créés en actif (gestion au hub).
CAP_ACCOUNT_MANAGEMENT=super_admin
# Voir les profils + « se mettre à leur place » (impersonation).
CAP_PROFILES=super_admin
# Changer le mot de passe administrateur dans les Paramètres.
CAP_ADMIN_PASSWORD=super_admin
# Bouton « Mettre à jour le site » (git + pip + redémarrage). off pour le désactiver.
CAP_SITE_UPDATE=super_admin

# --- Web Push (notifications métier des conducteurs — cahier §8) ---
# Les clés VAPID sont générées automatiquement au 1er envoi et stockées en base
# (app_settings) — rien à configurer ici. Requiert `pywebpush` (requirements.txt).
# SUPERADMIN_EMAIL ci-dessus sert de contact VAPID (claim « sub »).

# --- Notifications BotPanel (https://github.com/SuperNon0/botpanel) ---
# Laisse vide pour désactiver les notifications.
BOTPANEL_URL=
BOTPANEL_TIMEOUT=5
# Slugs des notifications créées dans BotPanel (change-les si tu veux) :
NOTIFY_SLUG_ACCESS_REQUEST=acces_demande
NOTIFY_SLUG_ACCESS_VALIDATED=acces_valide
NOTIFY_SLUG_ACCESS_BLOCKED=acces_bloque
