[Unit]
Description=VTC — gestion des courses (Flask + gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vtc
Group=vtc
WorkingDirectory=/opt/vtc
EnvironmentFile=/opt/vtc/.env
ExecStart=/opt/vtc/.venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 wsgi:app
Restart=on-failure
RestartSec=3
# Durcissement léger
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/vtc/data

[Install]
WantedBy=multi-user.target
